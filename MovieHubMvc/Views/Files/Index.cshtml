@model MovieHubMvc.Models.FileUploadViewModel
@{
    ViewData["Title"] = "Files";
    var files = ViewBag.Files as List<MovieHubMvc.Models.FileItemViewModel> ?? new List<MovieHubMvc.Models.FileItemViewModel>();
}

<section class="trending" style="padding-top: 140px; min-height: 70vh;">
    <div class="container">

        <div class="section-header" style="margin-bottom: 28px;">
            <h2>@L["Files_Title"]</h2>
        </div>

        <p style="color:#bdbdbd; margin-bottom: 24px; max-width: 640px;">
            Upload posters, screenshots, subtitles or other files to the server
            (<code>wwwroot/Files</code>). Then open any file from the list below.
        </p>

        @if (TempData["Success"] != null)
        {
            <div style="background:#1a3a1a;border:1px solid #2d5a2d;color:#8fdf8f;padding:14px 18px;border-radius:12px;margin-bottom:24px;">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }

        <!-- Upload form (Razor, multipart) -->
        <div style="background:#1a1a1a;padding:28px;border-radius:16px;border:1px solid #2a2a2a;margin-bottom:40px;max-width:640px;">
            <h3 style="margin-top:0;margin-bottom:18px;font-size:20px;">@L["Files_Upload"]</h3>

            <form asp-controller="Files" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" style="color:#ff6b6b;margin-bottom:12px;"></div>

                <div style="margin-bottom:16px;">
                    <label asp-for="File" style="display:block;margin-bottom:6px;font-weight:500;"></label>
                    <input asp-for="File" type="file" class="form-control"
                           style="width:100%;padding:12px;border-radius:10px;border:1px solid #333;background:#111;color:#fff;" />
                    <span asp-validation-for="File" style="color:#ff6b6b;font-size:13px;"></span>
                    <p style="color:#888;font-size:13px;margin:8px 0 0;">Max 10 MB. Images, pdf, txt, srt, mp4, zip…</p>
                </div>

                <div style="margin-bottom:20px;">
                    <label asp-for="Description" style="display:block;margin-bottom:6px;font-weight:500;"></label>
                    <input asp-for="Description" class="form-control"
                           style="width:100%;padding:12px 16px;border-radius:10px;border:1px solid #333;background:#111;color:#fff;"
                           placeholder="e.g. Interstellar poster" />
                </div>

                <button type="submit" class="hero-btn" style="border:none;cursor:pointer;">
                    <i class="fa-solid fa-cloud-arrow-up"></i> @L["Files_Button"]
                </button>
            </form>
        </div>

        <!-- File list -->
        <h3 style="margin-bottom:18px;">Files on server (@files.Count)</h3>

        @if (files.Count == 0)
        {
            <p style="color:#888;">No files yet. Upload the first one above.</p>
        }
        else
        {
            <div style="display:grid;gap:12px;">
                @foreach (var f in files)
                {
                    <div style="display:flex;align-items:center;gap:16px;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:12px;padding:14px 18px;">
                        <div style="width:42px;height:42px;border-radius:10px;background:#222;display:flex;align-items:center;justify-content:center;color:#E50914;">
                            <i class="fa-solid @(f.Extension is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" ? "fa-image" : f.Extension is ".pdf" ? "fa-file-pdf" : f.Extension is ".mp4" or ".webm" ? "fa-film" : "fa-file")"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <a asp-controller="Files" asp-action="View" asp-route-name="@f.Name"
                               style="color:#fff;font-weight:500;text-decoration:none;">
                                @f.Name
                            </a>
                            <div style="color:#888;font-size:13px;margin-top:2px;">
                                @f.SizeDisplay · @f.UploadedAt.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        </div>
                        <a asp-controller="Files" asp-action="View" asp-route-name="@f.Name"
                           class="secondary-btn" style="padding:8px 16px;font-size:14px;text-decoration:none;">
                            Open
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
