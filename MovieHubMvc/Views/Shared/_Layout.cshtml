<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/header.css" />
    <link rel="stylesheet" href="~/css/footer.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header">
        <div class="container">
            <nav class="navbar">
                <a asp-controller="Home" asp-action="Index" class="logo">
                    <i class="fa-solid fa-clapperboard"></i> MovieHub
                </a>

                <ul class="nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                            @L["Nav_Home"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Movies" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movies" ? "active" : "")">
                            @L["Nav_Movies"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contact" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Contact" ? "active" : "")">
                            @L["Nav_Contact"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Files" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Files" ? "active" : "")">
                            @L["Nav_Files"]
                        </a>
                    </li>
                    <li class="nav-mobile-only">
                        <a asp-controller="Favorites" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Favorites" ? "active" : "")">
                            ❤ @L["Nav_Favorites"]
                        </a>
                    </li>
                </ul>

                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="@L["Search_Placeholder"]" autocomplete="off">
                </div>

                <!-- Language switcher (partial) -->
                <partial name="_LanguageSwitcher" />

                <div class="nav-actions">
                    <a asp-controller="Favorites" asp-action="Index" class="favorite-btn" title="@L["Nav_Favorites"]">
                        <i class="fa-regular fa-heart"></i>
                    </a>
                    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p class="mb-0 text-center" style="padding: 40px 0 20px; color: #888;">
                © @DateTime.Now.Year MovieHub — @L["Footer_Text"]
            </p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/header.js"></script>
    <script src="~/js/data.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
